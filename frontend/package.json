    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "cropperjs": "^1.6.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^11.18.1",
    "heroicons": "^2.2.0",
    "jspdf": "^3.0.0",
    "jspdf-autotable": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-cropper": "^2.3.3",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.2.0",
    "react-icons": "^5.4.0",
    "react-image-crop": "^11.0.7",
    "react-router-dom": "^6.27.0",
    "react-scripts": "5.0.1",
    "react-sharp": "^1.0.0",
    "react-toastify": "^11.0.3",
    "react-tooltip": "^5.28.0",
    "sharp": "^0.33.5",
    "socket.io-client": "^4.8.1",
    "swiper": "^11.2.6",
    "tailwind-scrollbar": "^3.0.0",
    "tailwind-scrollbar-hide": "^2.0.0",
    "web-push": "^3.6.7",
    "web-vitals": "^2.1.4",
    "yocto-queue": "^1.2.0"
  },
  "scripts": {
    "start": "set PORT=3001 && concurrently \"npm run server\" \"npm run client\"",
    "server": "cd ../backend && node server.js",
    "client": "react-scripts start --host 0.0.0.0",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "overrides": [
      {
        "files": [
          "public/service-worker.js"
        ],
        "env": {
          "serviceworker": true
        },
        "rules": {
          "no-restricted-globals": "off"
        }
      }
    ],
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16"
  }
}
